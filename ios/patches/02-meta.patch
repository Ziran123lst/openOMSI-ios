+++ b/crates/omsi-app/Cargo.toml
@@ -7,7 +7,9 @@ description = "The openOMSI application: loads a map and renders it"
 
 # The game is a library with a small `main` around it: the Android build takes the same
 # library as a shared object (`cargo rustc --lib --crate-type cdylib`, see
-# scripts/build-android.sh), which the phone's NativeActivity loads.
+# scripts/build-android.sh), which the phone's NativeActivity loads, and the iOS build as
+# a static library (`cargo rustc --lib --crate-type staticlib`, scripts/build-ios.sh),
+# which the Xcode project links into the app.
 [lib]
 name = "openomsi_game"
 path = "src/lib.rs"
@@ -61,8 +63,9 @@ rust-i18n = "4"
 # updates: the release archives from GitHub
 zip = { version = "2", default-features = false, features = ["deflate"] }
 
-# the desktop's clipboard and file dialogs (a phone has neither in this form)
-[target.'cfg(not(target_os = "android"))'.dependencies]
+# the desktop's clipboard and file dialogs (a phone has neither in this form; arboard and
+# rfd have no iOS backend - iOS uses the in-app clipboard, see launcher/mod.rs)
+[target.'cfg(not(any(target_os = "android", target_os = "ios")))'.dependencies]
 arboard = { version = "3", default-features = false }
 rfd = "0.15"
 
