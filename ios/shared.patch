+# (crc-fast builds a cdylib for wasm that this tree never uses; the iOS cross-linker on
+# this Linux box cannot link that cdylib (-exported_symbols_list), so the patch builds only
+# the rlib openOMSI needs.)
+[patch.crates-io]
+crc-fast = { path = "vendor/crc-fast" }
+
 [workspace.package]
 version = "0.1.0"
 edition = "2021"
@@ -66,3 +72,14 @@ opt-level = 1
 inherits = "release"
 debug = 0
 strip = "debuginfo"
+
+# the iOS build (scripts/build-ios.sh): like Android, without debug info
+[profile.ios]
+inherits = "release"
+debug = 0
+strip = "debuginfo"
+# the linker and the phone's code cache are both finite: no LTO (the .a keeps the
+# per-crate optimization, enough for a game that streams content at runtime), and a single
+# codegen unit keeps the peak memory of the big crates low enough for 4 GB build boxes
+lto = false
+codegen-units = 1
